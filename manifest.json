{
  "manifest_version": 3,
  "name": "Ask This Page (llama.cpp)",
  "version": "1.1.0",
  "description": "Ask a llama.cpp server questions about the current live page DOM.",
  "permissions": ["storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Ask this page"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
